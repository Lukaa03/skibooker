{
  "id": "b2c3d4e5-0001-4000-8000-000000000010",
  "version": "2.0",
  "name": "SSU_02 Prijava",
  "url": "http://127.0.0.1:8000",
  "tests": [
    {
      "id": "b2c3d4e5-0002-4000-8000-000000000011",
      "name": "Legalno - uspesna prijava",
      "commands": [
        {
          "id": "e01",
          "comment": "napomena: koristi postojeci aktivan nalog; admin se pravi migracijom",
          "command": "open",
          "target": "/accounts/login/",
          "targets": [],
          "value": ""
        },
        {
          "id": "e02",
          "comment": "email",
          "command": "executeScript",
          "target": "var el=document.querySelector(\"[name='email']\");el.value='admin@skibooker.rs';el.dispatchEvent(new Event('input',{bubbles:true}));el.dispatchEvent(new Event('change',{bubbles:true}));",
          "targets": [],
          "value": ""
        },
        {
          "id": "e03",
          "comment": "lozinka",
          "command": "executeScript",
          "target": "var el=document.querySelector(\"[name='password']\");el.value='admin123';el.dispatchEvent(new Event('input',{bubbles:true}));el.dispatchEvent(new Event('change',{bubbles:true}));",
          "targets": [],
          "value": ""
        },
        {
          "id": "e04",
          "comment": "submit",
          "command": "click",
          "target": "css=button[type='submit']",
          "targets": [],
          "value": ""
        },
        {
          "id": "e05",
          "comment": "posle uspeha redirect na home -> polje password vise ne postoji",
          "command": "assertElementNotPresent",
          "target": "name=password",
          "targets": [],
          "value": ""
        }
      ]
    },
    {
      "id": "b2c3d4e5-0003-4000-8000-000000000012",
