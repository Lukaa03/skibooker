          "id": "d08",
          "comment": "forma pala -> ostaje na registraciji, confirm_password i dalje postoji",
          "command": "assertElementPresent",
          "target": "name=confirm_password",
          "targets": [],
          "value": ""
        }
      ]
    }
  ],
  "suites": [
    {
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "SSU_01 Suite",
      "persistSession": false,
      "parallel": false,
